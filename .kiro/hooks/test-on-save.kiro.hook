{
  "enabled": true,
  "name": "Test on save",
  "description": "Run the test suite when source or tests change and fix failures.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["src/**/*.ts", "tests/**/*.ts"] },
  "then": { "type": "askAgent", "prompt": "Run `npm test`. If anything fails, diagnose and fix it. If you changed a pure function in src/gopher.ts, make sure a property-based test covers it." }
}
